# Root .gitignore — applies to whole repo. Subprojects may add their own.
# Note: poc-v2/backend/.gitignore already covers backend-specific entries.

# Node / TypeScript
node_modules/
dist/
build/
*.tsbuildinfo
.npm/
.pnpm-store/

# Logs (workspace is full of test/build logs)
*.log
*.err.log
*.out.log
# Service stdout/stderr redirects (Start-Process -RedirectStandard*)
*.out
*.err

# Databases / build artifacts
*.db
*.sqlite
*.sqlite3
coverage.html
coverage.out
.nyc_output/

# Vite dev / build cache (frontend)
.vite/
.vite-optimizer-cache/
.vite-deps/

# Test runner artifacts
playwright-report/
test-results/
.vitest-cache/

# TypeScript build info
*.tsbuildinfo
.tsbuild/

# Go runtime temp build outputs (defense-in-depth; backend/.gitignore also
# covers these, but the workspace root is broad)
.coverage/

# Local tools / downloads
.tools/

# Env / secrets
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Go binaries (defense-in-depth even if backend has its own .gitignore)
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Local smoke-test scratch
_smoke.ts
.poc-tests*.log

# Deprecated prototype (v1) — kept on disk as a reference but not part of
# the M0/M1 codebase. Uncomment the next line if you want to keep it out of
# git history entirely.
# poc.deprecated.bak/
