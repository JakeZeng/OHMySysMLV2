# syntax=docker/dockerfile:1.7
#
# SysML v2 MBSE Frontend (React + Vite + nginx)
# ─────────────────────────────────────────────────────────────────────────────
# Build:  docker buildx build -t sysmlv2-mbse/frontend:dev -f Dockerfile .
# Run:    docker run --rm -p 3000:80 \
#               --link sysmlv2-backend:backend \
#               sysmlv2-mbse/frontend:dev
# 访问:   http://localhost:3000   (容器内 nginx :80)
#
# 镜像选型说明
# ─────────────
#   Builder:  node:22-alpine       对齐 CI 用的 Node 22.x
#   Runtime:  nginx:1.27-alpine    静态文件服务 + /api/* 反代到 backend
#                                    镜像小、含 wget（healthcheck 用）
#
# 构建产物
# ─────────
#   Vite build → dist/
#   dist/      → /usr/share/nginx/html
#   nginx.conf → /etc/nginx/conf.d/default.conf
#
# 反代目标
# ────────
#   compose 里 backend service 名是 "backend"（docker network DNS）
#   nginx.conf 中已经写死 proxy_pass http://backend:8080;
#   不需要改 nginx.conf

# ─── Stage 1: builder ───────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# 单独 COPY package*.json 先 npm ci，命中缓存
# (*.json 是为了兼容 package-lock.json 还没生成的场景)
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# 复制源码
COPY . .

# Vite build：产物在 dist/
# 注意：vite.config.ts 里 dev/proxy 配置只在 dev server 生效
#       生产 build 不需要这些，产物是纯静态文件
RUN npm run build

# ─── Stage 2: runtime (nginx) ──────────────────────────────────────────────
FROM nginx:1.27-alpine

# 删掉 nginx 默认站点配置
RUN rm -f /etc/nginx/conf.d/default.conf

# 复制 build 产物
COPY --from=build /app/dist /usr/share/nginx/html

# 复制仓库自带的 nginx.conf（v0.x 已存在，含 /api/* 反代 + SPA fallback）
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 健康检查：访问 SPA 首页，验证 nginx 起来且静态文件可服务
# 注意：这里没设 8080，nginx 实际监听 80，compose 端口映射 3000:80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
    CMD wget -q --spider http://localhost/ || exit 1

EXPOSE 80

# nginx:alpine 镜像默认 CMD 是 nginx -g "daemon off;"
# 不覆盖，沿用上游默认

# 默认 backend 主机名（与 compose service 名一致）
ENV BACKEND_URL=http://backend:8080
