{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sysmlv2-poc.example.com/schema/v2",
  "title": "SysML v2 POC Model",
  "description": "SysML v2 POC 工具的模型 JSON 格式。M17 切片 B 起升 v2,首次纳入 view / viewpoint / nested view。",
  "type": "object",
  "required": ["$schema", "version", "exportedAt", "model"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://sysmlv2-poc.example.com/schema/v2"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "$ref": "#/definitions/SysMLModel"
    }
  },
  "definitions": {
    "SysMLModel": {
      "type": "object",
      "required": ["packages", "connections"],
      "properties": {
        "packages": {
          "type": "array",
          "items": { "$ref": "#/definitions/Package" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/definitions/Connection" }
        },
        "views": {
          "type": "array",
          "description": "M17 切片 B:顶层 view 数组(ViewDefinition / ViewUsage / shorthand)",
          "items": { "$ref": "#/definitions/View" }
        },
        "viewpoints": {
          "type": "array",
          "description": "M17 切片 B:顶层 viewpoint 数组",
          "items": { "$ref": "#/definitions/Viewpoint" }
        }
      }
    },
    "SourceLocation": {
      "type": "object",
      "required": ["line", "column", "offset"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "Package": {
      "type": "object",
      "required": ["kind", "name", "members", "location"],
      "properties": {
        "kind": { "const": "package" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isImplicitRoot": {
          "type": "boolean",
          "description": "M16 P1：解析器为顶层裸元素合成的隐式根包（官方隐式根 Namespace，name 为空串）"
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/definitions/NamespaceMember" }
        },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "NamespaceMember": {
      "oneOf": [
        { "$ref": "#/definitions/Package" },
        { "$ref": "#/definitions/ImportStatement" },
        { "$ref": "#/definitions/PartDefinition" },
        { "$ref": "#/definitions/PortDefinition" },
        { "$ref": "#/definitions/PartUsage" },
        { "$ref": "#/definitions/PortUsage" },
        { "$ref": "#/definitions/AttributeUsage" },
        { "$ref": "#/definitions/Connection" },
        { "$ref": "#/definitions/View" },
        { "$ref": "#/definitions/Viewpoint" }
      ]
    },
    "ImportStatement": {
      "type": "object",
      "required": ["kind", "namespace", "location"],
      "properties": {
        "kind": { "const": "import" },
        "id": { "type": "string" },
        "namespace": { "type": "string" },
        "isRecursive": { "type": "boolean" },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "PartDefinition": {
      "type": "object",
      "required": ["kind", "name", "body", "location"],
      "properties": {
        "kind": { "const": "partDef" },
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "isAbstract": { "type": "boolean" },
        "inherits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "body": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/PortUsage" },
              { "$ref": "#/definitions/AttributeUsage" }
            ]
          }
        },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "PortDefinition": {
      "type": "object",
      "required": ["kind", "name", "body", "location"],
      "properties": {
        "kind": { "const": "portDef" },
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "isAbstract": { "type": "boolean" },
        "direction": { "enum": ["in", "out", "inout"] },
        "inherits": {
          "type": "array",
          "items": { "type": "string" }
        },
        "body": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/PortUsage" },
              { "$ref": "#/definitions/AttributeUsage" }
            ]
          }
        },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "PartUsage": {
      "type": "object",
      "required": ["kind", "name", "typeRef", "body", "location"],
      "properties": {
        "kind": { "const": "partUsage" },
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "typeRef": { "type": "string" },
        "body": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/PortUsage" },
              { "$ref": "#/definitions/AttributeUsage" }
            ]
          }
        },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "PortUsage": {
      "type": "object",
      "required": ["kind", "location"],
      "properties": {
        "kind": { "const": "portUsage" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "typeRef": { "type": "string" },
        "redefines": { "type": "string" },
        "direction": { "enum": ["in", "out", "inout"] },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "AttributeUsage": {
      "type": "object",
      "required": ["kind", "name", "typeRef", "location"],
      "properties": {
        "kind": { "const": "attributeUsage" },
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "typeRef": { "type": "string" },
        "defaultValue": { "type": "string" },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "Connection": {
      "type": "object",
      "required": ["kind", "source", "target", "location"],
      "properties": {
        "kind": { "const": "connection" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "source": { "$ref": "#/definitions/EndpointRef" },
        "target": { "$ref": "#/definitions/EndpointRef" },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "EndpointRef": {
      "type": "object",
      "required": ["partName", "portName", "location"],
      "properties": {
        "partName": { "type": "string" },
        "portName": { "type": "string" },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "View": {
      "type": "object",
      "required": ["kind", "name", "location"],
      "description": "M17 切片 B:M15/M16 遗留 schema 补全。ViewDefinition / ViewUsage / shorthand 通过 declKind 区分。",
      "properties": {
        "kind": { "const": "view" },
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "declKind": {
          "type": "string",
          "enum": ["definition", "usage", "shorthand"],
          "description": "§7.26 三种声明形式(view def N{} / view N: Def{} / view N{})"
        },
        "viewDefinitionRef": { "type": "string" },
        "specializes": { "type": "string" },
        "satisfies": { "type": "string" },
        "reveals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "expose 引用列表(qualified paths)"
        },
        "filters": {
          "type": "array",
          "items": { "type": "string" },
          "description": "filter 子句列表(Q17-B:文本原样保留给 expr 引擎解析)"
        },
        "renderKind": { "type": "string" },
        "renderingRef": { "type": "string" },
        "multipleRenders": { "type": "boolean" },
        "members": {
          "type": "array",
          "description": "view body 内 owned 成员(Q13-C 弱 namespace,qualified name = V::X)",
          "items": { "$ref": "#/definitions/NamespaceMember" }
        },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    },
    "Viewpoint": {
      "type": "object",
      "required": ["kind", "name", "location"],
      "description": "M17 切片 B:M15 §7.26 Viewpoint。ViewpointDefinition 是 RequirementDefinition 的特化,subject 表达关注点。",
      "properties": {
        "kind": { "const": "viewpoint" },
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "declKind": {
          "type": "string",
          "enum": ["definition", "usage", "shorthand"]
        },
        "viewpointDefinitionRef": { "type": "string" },
        "subject": {
          "type": "string",
          "description": "§7.26 subject : T;——关注点关联"
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/definitions/NamespaceMember" }
        },
        "location": { "$ref": "#/definitions/SourceLocation" }
      }
    }
  }
}