# Server
SERVER_PORT=8080
SERVER_ENV=development
SERVER_CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgres://mbse:mbse_dev_password@localhost:5432/mbse?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# JWT
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=mbse-system
JWT_AUDIENCE=mbse-api

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Migrations (auto-run on startup by default)
MIGRATIONS_AUTO_RUN=true
MIGRATIONS_DIR=./migrations
