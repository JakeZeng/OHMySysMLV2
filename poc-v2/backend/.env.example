# SysML v2 MBSE 后端环境变量（开发用模板）
#
# 用法：
#   cp .env.example .env
#   按需修改
#
# 与生产环境 .env.production 的差异：
#   - JWT_SECRET 这里是占位值，dev 后端启动时会校验；
#     如不想设 JWT_SECRET，可直接跑（dev 模式允许占位）
#   - AI_API_KEY 留空 → AI 端点跳过调用（dev 体验不影响其它功能）
#   - CORS_ALLOWED_ORIGINS 默认 localhost:3000 + localhost:5173 (Vite dev)

# ===== 服务端口 =====
PORT=8080
# SQLite 文件位置（dev：相对路径；docker：/data/sysmlv2.db）
DB_PATH=./sysmlv2.db
# Gin 运行模式（开发可改 debug 看详细日志；生产固定 release）
GIN_MODE=debug

# ===== 鉴权 =====
# JWT 签名密钥（dev 占位即可，启动不会报错）
# 生产必须用：openssl rand -hex 32  生成至少 32 字节随机
JWT_SECRET=change-me-in-production

# ===== AI Provider（M3 NL→SysML v2 功能）=====
# 支持：openai | deepseek | anthropic
AI_PROVIDER=openai
# API key（dev 留空 → AI 端点 503 不影响其它路由）
AI_API_KEY=
# 自定义 base URL（Azure / 代理 / DeepSeek 专用 endpoint 时填）
# OpenAI 默认：https://api.openai.com/v1
# DeepSeek：https://api.deepseek.com/v1
# Anthropic 默认：https://api.anthropic.com
AI_BASE_URL=
# 模型名（按 provider 默认值填写）
# openai: gpt-4o-mini / gpt-4o
# deepseek: deepseek-chat
# anthropic: claude-3-5-sonnet-latest
AI_MODEL=gpt-4o-mini
# 单次请求最大 token（防止 prompt 过长）
AI_MAX_TOKENS=2048
# Fallback provider（可选；主 provider rate limit 时切备选）
# AI_FALLBACK_PROVIDER=deepseek
# AI_FALLBACK_API_KEY=

# ===== 安全（M3 加固）=====
# CORS 白名单（逗号分隔）；dev 默认允许 Vite + 同源
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 限流（每 IP 每分钟请求数；dev 默认 60）
RATE_LIMIT_PER_MIN=60
# 请求体大小上限（字节；dev 默认 1MB）
BODY_SIZE_LIMIT=1048576

# ===== Observability =====
# 开启访问日志
LOG_REQUESTS=true
# 日志级别（debug/info/warn/error）
LOG_LEVEL=info
